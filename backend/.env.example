# Copy this file to .env and fill in your keys. Never commit .env.

# Keys for the providers used by your model profile (see config/models.yaml).
OPENAI_API_KEY=
GROQ_API_KEY=

# Postgres for chats, carts and memory (Supabase: use the SESSION pooler URL,
# port 5432). Leave empty to keep everything in memory (lost on restart).
DATABASE_URL=

# Langfuse tracing + prompt management (optional; off when empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional overrides (defaults shown)
# ENVIRONMENT=development
# MODEL_PROFILE=budget
# KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=INFO
# SENTRY_DSN=https://...@sentry.io/...   (optional error alerts)
